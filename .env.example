# Core bot WebSocket URL
CORE_WS_URL=ws://bot:8765

# Must match RunnerSecret in config.js
RUNNER_SECRET=

# Optional, for multi runner region selection
RUNNER_REGION=

# Healthcheck. Returns 200 when it is connected to core.
# otherwise 503. Used by Docker HEALTHCHECK / compose healthcheck.
# HEALTHCHECK_ENABLED=1
# HEALTHCHECK_PORT=8080
# HEALTHCHECK_HOST=0.0.0.0
